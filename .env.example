# Copy this file to .env (setup_rag.sh does this for you). Never commit .env to GitHub.

# Which engine runs embeddings + chat: "local" (free) or "azure" (needs funding + keys below)
MODEL_PROVIDER=local

# --- Local models (MODEL_PROVIDER=local) ---
# Embeddings run inside Python (sentence-transformers). If you change the model, run
# "bash start.sh ingest" afterwards (it downloads the new model and re-indexes).
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chat model: an Ollama model name. It must already be downloaded.
# start.sh builds a per-session copy of it that uses exactly your Slurm CPU count.
LOCAL_LLM_MODEL=llama3.2:3b

# The Ollama address is set automatically by start.sh; you normally never need this.
# Only for running Python by hand against a server you started yourself:
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11500/v1
# Only needed if your server was started with an API key
# LOCAL_LLM_API_KEY=

# --- Future use: Azure (MODEL_PROVIDER=azure) ---
# AZURE_FOUNDRY_PROJECT_ENDPOINT=
# AZURE_FOUNDRY_API_KEY=
# AZURE_FOUNDRY_VERSION=
# AZURE_FOUNDRY_MODEL_NAME=
#
# AZURE_EMBEDDING_ENDPOINT=
# AZURE_EMBEDDING_API_KEY=
# AZURE_EMBEDDING_VERSION=
# AZURE_EMBEDDING_MODEL_NAME=
