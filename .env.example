# Copy this file to .env. Never commit .env to GitHub.

# Which engine runs embeddings + chat: "local" (free) or "azure" (needs funding + keys below)
MODEL_PROVIDER=local

# --- Local models (MODEL_PROVIDER=local) ---
# Embeddings run inside Python (sentence-transformers). The model downloads on first use.
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chat model: any OpenAI-compatible server you run yourself.
#   Ollama default:  http://localhost:11434/v1   model names look like llama3.2:3b
#   vLLM default:    http://localhost:8000/v1    model names look like Qwen/Qwen2.5-3B-Instruct
LOCAL_LLM_BASE_URL=http://127.0.0.1:11500/v1
LOCAL_LLM_MODEL=llama3.2:3b
# Only needed if your server was started with an API key (recommended on shared cluster nodes)
# LOCAL_LLM_API_KEY=

# --- Future use: Azure (MODEL_PROVIDER=azure) ---
# AZURE_FOUNDRY_PROJECT_ENDPOINT=
# AZURE_FOUNDRY_API_KEY=
# AZURE_FOUNDRY_VERSION=
# AZURE_FOUNDRY_MODEL_NAME=
#
# AZURE_EMBEDDING_ENDPOINT=
# AZURE_EMBEDDING_API_KEY=
# AZURE_EMBEDDING_VERSION=
# AZURE_EMBEDDING_MODEL_NAME=
